# IXC Provedor API
IXC_HOST=https://SEU_DOMINIO.ixcsoft.com.br
IXC_TOKEN=SEU_ID:SEU_TOKEN

# Server
PORT=3000
CACHE_TTL_MINUTES=5

# URL publica usada pelo app Android. Sem dominio, use IP:porta.
PUBLIC_BASE_URL=http://SEU_IP_DA_VPS:3000
APP_TIMEZONE=America/Recife

# Login web. Nao publique a senha real no GitHub.
AUTH_USER=Objetivo
AUTH_PASSWORD=SENHA_WEB_AQUI
AUTH_COOKIE_SECRET=GERAR_UM_SEGREDO_GRANDE_AQUI
AUTH_SESSION_HOURS=12

# Token usado pelo APK para enviar GPS.
GPS_INGEST_TOKEN=GERAR_UM_TOKEN_GRANDE_AQUI
GPS_STOP_RADIUS_METERS=35
GPS_STOP_MIN_SECONDS=120
GPS_STALE_SECONDS=180
GPS_MAX_ACCURACY_METERS=120
